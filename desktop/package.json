{
  "name": "gumi-code-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "GuMi-Code desktop coding agent",
  "author": "GuMiShDo",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test test/*.test.cjs",
    "package": "node package-app.cjs",
    "prepare:runtime": "node scripts/prepare-gumcode-runtime.cjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "electron": "44.2.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
